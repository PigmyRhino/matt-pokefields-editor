              "key": "mtmoon_miner_gold_done",
              "kind": "flag_set"
            },
            "id": "farewell_gold_check",
            "if_false": "farewell_any",
            "if_true": "farewell_all",
            "kind": "condition"
          },
          {
            "cond": {
              "key": "mtmoon_miner_copper_done",
              "kind": "flag_set"
            },
            "id": "farewell_any",
            "if_false": "farewell_none",
            "if_true": "farewell_partial",
            "kind": "condition"
          },
          {
            "action": {
              "kind": "say",
              "text": "You've cleaned me out, kid! Every tier, every geode. You're a natural-born miner — best I've seen in decades. If you ever make it to deeper caves, look me up. I might have rarer trades then."
            },
            "id": "farewell_all",
            "kind": "action"
          },
          {
            "action": {
              "kind": "say",
              "text": "Good work so far. Keep swinging that pickaxe — the deeper you go in these caves, the better the ore gets. Come back when you've collected more."
            },
            "id": "farewell_partial",
            "kind": "action"
          },
          {
            "action": {
              "kind": "say",
              "text": "You still owe me some ore, rookie! Swing that pickaxe at any sparkly rock you see in the cave. Copper, iron, silver, gold — bring it all to me and I'll make it worth your while."
            },
            "id": "farewell_none",
            "kind": "action"
          }
        ]
      },
